{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "Ticketer Docs",
  "colors": {
    "primary": "#5865F2",
    "light": "#5865F2",
    "dark": "#5865F2"
  },
  "favicon": "/logo/Ticketer-Icon-Light.png",
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Invite Ticketer",
          "icon": "plus-large",
          "color": {
            "light": "#5865F2",
            "dark": "#5865F2"
          },
          "href": "https://ticketer.bot/invite"
        }
      ]
    },
    "anchors": [
      {
        "anchor": "Dashboard",
        "icon": "grid-2-plus",
        "color": {
          "light": "#5865F2",
          "dark": "#5865F2"
        },
        "href": "https://dashboard.ticketer.bot"
      },
      {
        "anchor": "Support Server",
        "icon": "message-dots",
        "color": {
          "light": "#5865F2",
          "dark": "#5865F2"
        },
        "href": "https://ticketer.bot/discord"
      },
      {
        "anchor": "Vote for Ticketer",
        "icon": "thumbs-up",
        "color": {
          "light": "#5865F2",
          "dark": "#5865F2"
        },
        "href": "https://top.gg/bot/1453525696373723247/vote"
      },
      {
        "anchor": "Ticketer Bot Docs",
        "color": {
          "light": "#5865F2",
          "dark": "#5865F2"
        },
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "introduction",
              "setup"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/Ticketer_Docs.png",
    "dark": "/logo/Ticketer_Docs.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "https://ticketer.bot/discord"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dashboard.mintlify.com"
    }
  },
  "contextual": {
    "options": [
     "copy",
     "view",
     "chatgpt",
     "claude",
     "perplexity",
     "mcp",
     "cursor",
     "vscode"
   ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/mintlify",
      "github": "https://github.com/mintlify",
      "linkedin": "https://linkedin.com/company/mintlify"
    }
  },
  "fonts": {
    "family": "Plus Jakarta Sans"
  },
  "appearance": {
    "default": "system"
  }
}
